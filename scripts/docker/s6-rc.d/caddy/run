#!/command/with-contenv bash
# shellcheck shell=bash
# Public internet only reaches port 8080 (mapped from VM host). Caddy whitelists
# specific paths and proxies them to Rome on port 4141. rome-init.sh generates
# the Caddyfile.
echo "Starting Caddy (public proxy on :8080) ..."
exec caddy run --config /etc/caddy/Caddyfile
