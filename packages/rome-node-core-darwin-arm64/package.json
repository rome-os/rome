{
  "name": "@rome-os/node-core-darwin-arm64",
  "version": "0.1.8",
  "description": "macOS Apple Silicon native computer-use helper for @rome-os/node-core",
  "license": "MIT",
  "type": "module",
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist/native/Rome Computer Use.app",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"\"",
    "build:native": "node ../rome-node-core/scripts/build-computer-use.ts --output 'dist/native/Rome Computer Use.app'",
    "prepack": "node ../rome-node-core/scripts/verify-native-package.ts --app 'dist/native/Rome Computer Use.app'",
    "prepublishOnly": "node ../rome-node-core/scripts/verify-native-package.ts --app 'dist/native/Rome Computer Use.app' --release"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rome-os/rome.git",
    "directory": "packages/rome-node-core-darwin-arm64"
  }
}
