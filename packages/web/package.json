{
  "name": "rome-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:kit && rsbuild dev",
    "dev:mock": "pnpm build:kit && rsbuild dev --config mock/rsbuild.config.ts",
    "build:kit": "pnpm --filter \"rome-web^...\" run build",
    "build": "tsc --noEmit && rsbuild build",
    "typecheck": "tsc --noEmit",
