{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "useDefineForClassFields": true,
    "types": ["@rsbuild/core/types", "mdx"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "rsbuild.config.ts",
    "mock/**/*.ts",
    "mock/**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/app",
    "src/middleware.ts",
    "src/components/sidebar.tsx",
    "src/lib/rome-app-page.ts",
    "src/lib/file-browser-server.ts",
    "src/lib/provider-accounts.ts",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
