{
  "name": "rome-desktop",
  "version": "0.1.8",
  "private": true,
  "description": "Rome — local node for the Rome AI agent platform",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "pnpm --filter rome-desktop-base-web build && node scripts/dev.mjs",
    "build": "pnpm --filter rome-desktop-base-web build && node scripts/build.mjs",
    "test": "../../scripts/test-env.sh rstest",
    "rebuild:native": "node scripts/rebuild-native.mjs",
    "image:local": "bash scripts/build-local-image.sh",
    "smoke:guest-image": "node scripts/smoke-guest-image.mjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.45.1",
    "electron-updater": "^6.3.0",
    "winston": "^3.19.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@rstest/core": "^0.11.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.2.3",
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "rome-desktop-base-web": "workspace:*",
    "typescript": "^5.9.3"
  },
  "build": {
    "extends": "electron-builder.yml"
  }
}
