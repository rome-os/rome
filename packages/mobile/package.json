{
  "name": "rome-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Rome mobile — Expo / React Native WebView shell: sign in at Rome Cloud, hop to your own Rome instance, shell remembers it (Phase 1).",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "../../scripts/test-env.sh rstest",
    "test:watch": "../../scripts/test-env.sh rstest --watch"
  },
  "dependencies": {
    "@expo/ui": "~57.0.13",
    "@preeternal/react-native-cookie-manager": "^6.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.16",
    "expo-application": "~57.0.2",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-notifications": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "expo-widgets": "~57.0.12",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@rstest/core": "^0.11.11",
    "@types/react": "~19.2.14",
    "typescript": "~6.0.3"
  }
}
