{
  "name": "@rome-os/app-runtime",
  "version": "0.7.2",
  "description": "Runtime SDK for Rome apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rome-os/rome.git",
    "directory": "packages/app-runtime-sdk"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./app-id": {
      "types": "./dist/packaging/app-id.d.ts",
      "default": "./dist/packaging/app-id.js"
    },
    "./packaging": {
      "types": "./dist/packaging/index.d.ts",
      "default": "./dist/packaging/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./tsconfig.app.json": "./tsconfig.app.json"
  },
  "files": [
    "dist",
    "tsconfig.app.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "drizzle-orm": "^0.45.1",
    "semver": "^7.7.4",
    "tar": "^7.5.13",
    "ws": "^8.18.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.5.1",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.0",
    "typescript": "^5.9.3"
  }
}
