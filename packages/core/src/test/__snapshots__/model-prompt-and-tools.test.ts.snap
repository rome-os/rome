              },
              "minItems": 1,
              "type": "array",
            },
          },
          "required": [
            "questions",
          ],
          "type": "object",
        },
        "name": "ask_question",
      },
      {
        "description": "Schedule a wake-up later in THIS SAME conversation, with full context intact — use it when you're watching something that isn't ready yet (a CI run, a build, a reply) instead of ending the turn empty. Give a short \`name\` for what you're watching (it becomes the routine's name) and exactly one of \`afterMinutes\`, \`at\`, or \`event\`. Prefer \`event\` when something announces completion (CI finished, a PR merged, a reply): it wakes as soon as a matching event-bus event is published, once, on the first match, with no timeout. Look up the event name and payload fields with the search_event_catalog action first. For a \`subscribable\` type, filter on one of its \`keys\` (e.g. repository.full_name); defer then subscribes at the provider and fails with the reason if it can't. Events are not replayed and a new subscription only sees future events: after an event defer, check the current state once more, and if what you're waiting for already happened, handle it now. When you wake you're pinged back in this thread with the whole conversation still in context, so just re-evaluate and either finish or \`defer\` again (minimum one minute, no limit on re-defers). After calling defer, write one short line confirming you'll keep watch, then end your turn.",
        "inputSchema": {
          "properties": {
            "afterMinutes": {
              "description": "Minutes from now until wakeup, e.g. 5 (five minutes) or 120 (two hours). Minimum 1. Provide exactly one of afterMinutes, at, or event.",
              "minimum": 1,
              "type": "integer",
            },
            "at": {
              "description": "Absolute wakeup time as an ISO 8601 instant, e.g. 2026-06-25T14:30:00Z. Provide exactly one of afterMinutes, at, or event.",
              "type": "string",
            },
            "event": {
              "description": "Wake on the next event-bus event that matches. Provide exactly one of afterMinutes, at, or event.",
              "properties": {
                "eventName": {
                  "description": "The exact event type, from search_event_catalog, e.g. provider:event:github.workflow_run.",
                  "type": "string",
                },
                "filter": {
                  "description": "Optional payload conditions, AND-ed together. Each compares the payload value at a dot-path, as a string, for equality.",
                  "items": {
                    "properties": {
                      "equals": {
                        "description": "Value the field must equal",
                        "type": "string",
                      },
                      "field": {
                        "description": "Dot-path into the payload, e.g. pull_request.number",
                        "type": "string",
                      },
                    },
                    "required": [
                      "field",
                      "equals",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
                "sourcePattern": {
                  "description": "Optional: only match events from this source (an appId); a single * matches any run of characters.",
                  "type": "string",
                },
              },
              "required": [
                "eventName",
              ],
              "type": "object",
            },
            "name": {
              "description": "A short name for what you're watching, e.g. "GitHub CI run" or "Dana's reply". Stored as the routine's name and shown on the Routines page; you'll be pinged back in this same conversation when the time is up.",
              "type": "string",
            },
          },
          "required": [
            "name",
          ],
          "type": "object",
        },
        "name": "defer",
      },
    ],
    "skills": [
      {
        "description": "List the skills available in this workspace.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {},
          "type": "object",
        },
        "name": "list_skills",
      },
      {
        "description": "Search available skills by regex against name, description, or declared tools. Supports /pattern/flags for explicit flags.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "description": "Optional. Recommended: omit this parameter to use the default of 10. If provided, use an integer from 1 to 25.",
              "maximum": 25,
              "minimum": 1,
              "type": "integer",
            },
            "query": {
              "description": "Regex pattern to match skills, for example browser|calendar, or /web(fetch|search)/i for explicit flags.",
              "type": "string",
            },
          },
          "required": [
            "query",
          ],
          "type": "object",
        },
        "name": "search_skills",
      },
      {
        "description": "Read the full markdown for one available skill. When the skill ships companion files, the result also returns its \`directory\` and \`files\`; open one with your file tools only when the skill body points you to it.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "query": {
              "description": "Alias for skill_name. Use the exact skill name.",
              "type": "string",
            },
            "skill_name": {
              "description": "The skill name to read.",
              "type": "string",
            },
          },
          "type": "object",
        },
        "name": "read_skill",
      },
    ],
    "subagents": [],
  },
}
`;

exports[`what the model reads when a session opens > a core agent that loads no memory 1`] = `
{
  "systemPrompt": "You are a helper.

---

# Charter

Charter text.

---

# Identity

Identity text.

---

# Command Line Tools

- A global \`discord\` CLI is available to access Discord through Rome's connected bot. When a task requires current information from this connected Discord environment—such as channel history, messages, channels, threads, members, roles, or guild configuration—or a requested Discord management operation, prefer \`discord api\` over memory because it is live and authoritative. Run \`discord api --help\` when needed.
- Run \`rome-node help\` to learn the remote computer CLI and \`rome-node help device run\` for action arguments and result handling. Use \`rome-node device\` to list authorized remote computers. Authorization does not mean online. Use \`rome-node device describe <id>\` to query its platform and supported actions. Execute a program with \`rome-node device run <id> exec --args '{"command":"git","args":["status"],"cwd":"/workspace"}'\`. On macOS/Linux, read files with cat and list directories with ls. On Windows, explicitly invoke powershell.exe with Get-Content, Set-Content, or Get-ChildItem. Use an explicit shell for redirection or pipelines. Check exitCode, stderr, and truncated output. Never automatically retry an unknown outcome: a local timeout does not cancel the remote process. Never read or print device credential files.",
  "tools": {
    "actions": [
      {
        "description": "List the actions available to this agent.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {},
          "type": "object",
        },
        "name": "list_actions",
      },
      {
        "description": "Read one available action and its arguments.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "action_name": {
              "description": "The action name to inspect.",
              "type": "string",
            },
          },
          "required": [
            "action_name",
          ],
          "type": "object",
        },
        "name": "read_action",
      },
      {
        "description": "Search available actions by regex against name, description, or argument guidance. Supports /pattern/flags for explicit flags.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "description": "Optional. Recommended: omit this parameter to use the default of 10. If provided, use an integer from 1 to 25.",
              "maximum": 25,
              "minimum": 1,
              "type": "integer",
            },
            "query": {
              "description": "Regex pattern to match actions, or /pattern/flags for explicit flags.",
              "type": "string",
            },
          },
          "required": [
            "query",
          ],
          "type": "object",
        },
        "name": "search_actions",
      },
      {
        "description": "Execute one available action with object arguments in json_args.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "action_name": {
              "description": "The action name to execute.",
              "type": "string",
            },
            "json_args": {
              "additionalProperties": true,
              "description": "Object arguments to pass to the action.",
              "type": "object",
            },
          },
          "required": [
            "action_name",
            "json_args",
          ],
          "type": "object",
        },
        "name": "execute_action",
      },
    ],
    "ask_user": [
      {
        "description": "Ask the guardian one or more clarifying questions (single-choice, multi-choice, or short free-text), rendered as an interactive card in web chat or relayed as a plain message on other surfaces. Use it only when the answer would significantly change the direction of the work; otherwise proceed with your recommended approach and state your assumptions. When you do ask, use this tool rather than writing the questions in your text reply. Each call collects one set of questions, and the guardian's answers come back as the next turn. Prefer single-choice questions with concrete options when the likely answers are enumerable (set freeText so they can still type their own); use multi when several answers can apply at once.",
        "endsTurn": false,
        "inputSchema": {
          "properties": {
            "questions": {
              "description": "Questions rendered together as one card.",
              "items": {
                "properties": {
                  "freeText": {
                    "description": "single/multi only: also show a free-text box beneath the options, so the guardian can tap option(s) OR type their own answer. Use this for most choice questions — it keeps input cheap (a tap) without trapping them in your option set. Ignored for text.",
                    "type": "boolean",
                  },
                  "id": {
                    "description": "Stable id; the answer references it.",
                    "type": "string",
                  },
                  "optional": {
                    "description": "If true, the guardian may leave this question blank without blocking submit (a blank answer is simply omitted from the results). Defaults to false — questions are required.",
                    "type": "boolean",
                  },
                  "options": {
                    "description": "Required for single and multi; the choices. Ignored for text.",
                    "items": {
                      "type": "string",
                    },
                    "type": "array",
                  },
                  "question": {
                    "description": "The prompt shown to the guardian.",
                    "type": "string",
                  },
                  "type": {
                    "description": "single: pick exactly one option; multi: pick any number of options; text: free-form.",
                    "enum": [
                      "single",
                      "multi",
                      "text",
                    ],
                    "type": "string",
                  },
                },
                "required": [
                  "id",
                  "question",
                  "type",
                ],
                "type": "object",
              },
              "minItems": 1,
              "type": "array",
            },
          },
          "required": [
            "questions",
          ],
          "type": "object",
        },
        "name": "ask_question",
      },
    ],
    "skills": [
      {
        "description": "List the skills available in this workspace.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {},
          "type": "object",
        },
        "name": "list_skills",
      },
      {
        "description": "Search available skills by regex against name, description, or declared tools. Supports /pattern/flags for explicit flags.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "description": "Optional. Recommended: omit this parameter to use the default of 10. If provided, use an integer from 1 to 25.",
              "maximum": 25,
              "minimum": 1,
              "type": "integer",
            },
            "query": {
              "description": "Regex pattern to match skills, for example browser|calendar, or /web(fetch|search)/i for explicit flags.",
              "type": "string",
            },
          },
          "required": [
            "query",
          ],
          "type": "object",
        },
        "name": "search_skills",
      },
      {
        "description": "Read the full markdown for one available skill. When the skill ships companion files, the result also returns its \`directory\` and \`files\`; open one with your file tools only when the skill body points you to it.",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "query": {
              "description": "Alias for skill_name. Use the exact skill name.",
              "type": "string",
            },
            "skill_name": {
              "description": "The skill name to read.",
              "type": "string",
            },
          },
          "type": "object",
        },
        "name": "read_skill",
      },
    ],
    "subagents": [],
  },
}
`;

