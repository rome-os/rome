# =============================================================================
# Rome — Environment Variables
# =============================================================================
# Copy this file to .env and fill in required values.
#   cp .env.example .env
# =============================================================================

# --------------- Anthropic ---------------

# Anthropic API key (optional). If not provided, you can log in to your Claude
# account during onboarding to use the product instead.
ANTHROPIC_API_KEY=

# --------------- Profile ---------------

# Profile name for data isolation (default: "default")
ROME_PROFILE=default

# --------------- Database ---------------

# Database backend: "sqlite" (default) or "postgresql"
DATABASE_TYPE=sqlite

# Path to SQLite database file (default: ~/.rome/<profile>/rome.db)
# SQLITE_PATH=

# Optional encryption key for SQLite at-rest encryption
# SQLITE_ENCRYPTION_KEY=

# Required when DATABASE_TYPE=postgresql
# POSTGRES_CONNECTION_STRING=postgresql://user:pass@localhost:5432/rome

# --------------- Web Server ---------------

# Port and host for the Next.js web dashboard
WEB_PORT=3000
WEB_HOST=localhost

# JWT secret for guardian authentication (required for web UI login)
ROME_JWT_SECRET=

# Cloud guardian auth is gated by the `rome_cloud_auth` Statsig rollout gate
# (see STATSIG_SERVER_SECRET_KEY). When it passes, the cloud-login routes
# (/api/auth/cloud/*) and the "Sign in with Rome Cloud" button activate; when it
# fails (or no backend is wired) the instance falls back to local password auth.
#
# A cloud login always rejects when the browser account differs from the account
# that owns this instance, and fails closed when ownership can't be established
# (Rome Cloud unreachable / indeterminate). Unblock a wrongly-rejected guardian by
# turning cloud auth off for the instance, not by relaxing the ownership check.

# Statsig server secret key. When set, the rollout gate `rome_cloud_auth` is
# evaluated at each /login, keyed on PANTHEON_SLUG, so cloud auth can be flipped
# per instance without a restart. Absent disables the gate (fail closed to local
# auth). Secret — keep it out of source; prod injects it from the deploy secret
# store.
STATSIG_SERVER_SECRET_KEY=

# Feature-gate overrides. `FEATURE_GATE_<NAME>=<bool>` forces gate `<name>`
# (lowercased) on/off, winning over Statsig and needing no backend — for local
# dev, CI, or break-glass. Recognized tokens: 1/true/yes/on, 0/false/no/off.
# e.g. force cloud auth on with no Statsig project:
# FEATURE_GATE_ROME_CLOUD_AUTH=on

# Dedicated encryption key for stored third-party OAuth tokens
ROME_OAUTH_TOKEN_ENCRYPTION_KEY=

# Rome Cloud origin used for OAuth start + handoff redemption. A single origin
# serves both the browser and server-side legs, so it must be reachable from
# wherever Rome runs — inside a container, point this at a host-reachable address
# (e.g. http://host.docker.internal:3100), not a bare loopback.
PANTHEON_BASE_ORIGIN=https://romeos.cc

# Instance identity when provisioned through Rome Cloud
PANTHEON_DOMAIN=localhost
# Cloud-provisioned instances only — their Rome Cloud subdomain slug, injected at
# provision time. A self-hosted instance (loopback origin) has no address and
# brokers OAuth with no tenant, so leave this unset.
# PANTHEON_SLUG=

# This instance's own web origin — the browser-reachable address this Rome is
# served at. It is the authoritative source for the enrollment redirect target:
# the instance states where it lives rather than inferring it from request
# headers (which a proxy can rewrite). Normally derived as
# https://<PANTHEON_SLUG>.<PANTHEON_DOMAIN>; set this when Rome sits behind a
# proxy/tunnel whose public host isn't that derivation. Left unset, a
# local/desktop instance falls back to its own loopback address (WEB_PORT).
# PANTHEON_INSTANCE_ORIGIN=https://acme.romeos.dev
UPDATES_DOMAIN=updates.romeos.io

# Shared bearer token used for Rome -> Rome Cloud OAuth handoff redemption
PANTHEON_OAUTH_SERVICE_TOKEN=

# GA4 measurement ID (G-XXXXXXXXXX) for raw page-visit counting.
# Read at container RUNTIME by the boot script, which writes it into the SPA's
# runtime-config.js and the public-access gateway page — one value governs
# both, changeable or removable per deployment without rebuilding. Leave empty
# to disable analytics entirely (the default everywhere except the published
# image, whose default comes from a CI secret).
# Notes for operators: GA4 Enhanced Measurement reports RAW page URLs
# (including /share/<token> links and personal path metadata) to Google — an
# accepted product trade recorded — and GA4 sets cookies while
# Rome ships no consent UI, so enabling this where published apps reach EU
# visitors may create a GDPR/ePrivacy obligation for the operator.
# ROME_GA_MEASUREMENT_ID=

# --------------- Internal API ---------------

# Port and host for the backend internal API (used by web dashboard for hot-reload)
INTERNAL_API_PORT=4141
INTERNAL_API_HOST=localhost

# --------------- Observability ---------------

# OpenTelemetry OTLP HTTP endpoint (optional). When Rome runs via
# docker-compose.yml / compose.dev.yml, the compose file pins this to the
# in-stack `otel-collector` service (see infra/observability/
# otel-collector-config.yaml). Only set here when running outside compose.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ClickStack / ClickHouse credentials consumed by the in-stack OTEL collector
# (CLICKHOUSE_ENDPOINT / CLICKHOUSE_USERNAME / CLICKHOUSE_PASSWORD /
# CLICKHOUSE_DATABASE) are NOT placed in this file. The Rome backend never
# reads them; the collector reads them from a separate `.env.collector` file
# next to docker-compose.yml (prod) or the worktree root (dev). See
# `docs/observability/schema.md` for the full layout.

# Log level: debug, info, warn, error (default: info)
# LOG_LEVEL=info

# --------------- Tuning ---------------

# Minutes between sentinel review sweeps (default: 120)
# SENTINEL_REVIEW_INTERVAL_MINUTES=120

# LinkedIn inbox poll cadence: every tick draws a fresh uniform delay between
# the two bounds (defaults: 15 and 30), so syncs never fire on a fixed beat.
# LINKEDIN_POLL_MIN_MINUTES=15
# LINKEDIN_POLL_MAX_MINUTES=30

# Minutes the upgrade consent countdown runs before proceeding on silence
# (default: 10). Fits inside the reserved 3:00–3:30am nightly upgrade window.
# SYSTEM_UPGRADE_COUNTDOWN_MINUTES=10

# Maximum number of simultaneously live action-worker processes. This includes
# root, nested/delegated, and warm workers. Default: 8.
# ROME_ACTION_MAX_WORKERS=8

# --------------- Auto-Approval ---------------

# Auto-approve agent-initiated creations (default: true)
# AUTO_APPROVE_SKILLS=true
# AUTO_APPROVE_TOOLS=true
# AUTO_APPROVE_WORKFLOWS=true

# --------------- SSH Access ---------------
# Password for the "user" SSH account (optional — omit to use key-based auth only)
# SSH into the container: ssh -p 2222 user@<host>
SSH_USER_PASSWORD=

# --------------- Desktop App ---------------

# Download URL for Rome Desktop app (shown during onboarding)
NEXT_PUBLIC_DESKTOP_DOWNLOAD_URL=https://updates.romeos.io
STATSIG_CLIENT_KEY=

# --------------- Docker Hub (GitHub Actions) ---------------
# These are configured as GitHub repository secrets, not in .env.
# Required for the docker-publish workflow to push images to Docker Hub.
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=

# API Key
INTERNAL_API_WEBHOOK_API_KEY=

ROME_DOCKER_APP_CODE_MODE=compiled

# Webhook relay drainer
# Both vars are required together to enable the drainer — setting only one fails
# config validation loudly. When enabled, Rome holds a persistent WebSocket to
# the Cloudflare relay, drains buffered webhooks, and replays them into the
# consuming app's handler in-process. Provision URL+key through Rome Cloud's
# authenticated `POST /api/relay/mailboxes` endpoint, then use the returned
# `connectUrl` (wss://.../c/<id>) and `drainKey`. The delivery target is NOT
# configured here: core resolves it from whichever installed app declares
# `api.relayWebhook` (composio today), so a depositor can't redirect delivery.
# RELAY_DRAIN_URL=
# RELAY_DRAIN_KEY=

# Host root execution requires owner opt-in here and in the host daemon policy.
# ROME_HOST_EXECUTION_SOCKET=/run/rome-host/control.sock
ROME_HOST_EXECUTION_ENABLED=false
