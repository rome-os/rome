{
  "name": "@rome/core",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch --exclude '../../rome_apps/**' --exclude \"$HOME/.rome/**\" src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "test": "../../scripts/test-env.sh rstest",
    "test:watch": "../../scripts/test-env.sh rstest --watch",
    "test:unit": "../../scripts/test-env.sh rstest --exclude '**/*.integration.test.ts' --exclude '**/*.e2e.test.ts'",
    "test:integration": "../../scripts/test-env.sh rstest integration.test",
    "test:e2e": "../../scripts/test-env.sh rstest e2e.test",
    "test:coverage": "../../scripts/test-env.sh rstest --coverage --pool.maxWorkers=8",
    "test:ci": "../../scripts/test-env.sh env RSTEST_JUNIT=1 rstest --coverage --pool.maxWorkers=8",
    "db:generate:system": "drizzle-kit generate --config drizzle.system.config.ts",
    "db:generate:app": "drizzle-kit generate --config drizzle.authoring.config.ts",
    "db:migrate": "if [ \"${ROME_DOCKER_APP_CODE_MODE:-source}\" = \"compiled\" ]; then node dist/db/migrate.js; else tsx src/db/migrate.ts; fi",
    "db:push:system": "mkdir -p ~/.rome/${ROME_PROFILE:-default} && drizzle-kit push --config drizzle.system.config.ts",
    "db:push:app": "mkdir -p ~/.rome/${ROME_PROFILE:-default} && drizzle-kit push --config drizzle.authoring.config.ts",
    "db:studio": "drizzle-kit studio",
    "seed:sessions-explorer": "tsx src/bin/seed-sessions-explorer.ts",
    "app:pack": "tsx bin/apps-cli.js pack",
    "app:pack:first-party": "tsx bin/apps-cli.js pack:first-party",
    "app:install": "tsx bin/apps-cli.js install",
    "app:uninstall": "tsx bin/apps-cli.js uninstall",
    "app:list:required": "tsx bin/apps-cli.js list:required"
  },
  "oclif": {
    "bin": "rome-apps",
    "commands": "./src/apps/cli/commands",
    "topicSeparator": ":",
    "topics": {
      "install": {
        "description": "Apply apps (first-party or dev) to the running daemon"
      },
      "pack": {
        "description": "Build release artifacts from app sources (a single app, or all first-party apps)"
      },
      "list": {
        "description": "Inspect derived app sets"
      }
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.251",
    "@hono/node-server": "^1.19.14",
    "@larksuiteoapi/node-sdk": "^1.68.0",
    "@mozilla/readability": "^0.6.0",
    "@oclif/core": "^4.11.3",
    "@openai/codex": "0.144.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.212.0",
    "@opentelemetry/auto-instrumentations-node": "^0.69.0",
    "@opentelemetry/core": "^2.5.1",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.212.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.212.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.212.0",
    "@opentelemetry/sdk-logs": "^0.212.0",
    "@opentelemetry/sdk-metrics": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@opentelemetry/sdk-trace-base": "^2.5.1",
    "@rome-os/app-runtime": "workspace:*",
    "@rome/api-types": "workspace:*",
    "@rome-os/libs": "workspace:*",
    "@rspack/resolver": "^0.4.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.16.0",
    "@whiskeysockets/baileys": "7.0.0-rc.9",
    "ajv": "^8.18.0",
    "async-mutex": "0.5.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "chokidar": "^5.0.0",
    "croner": "^10.0.1",
    "discord.js": "^14.26.2",
    "dompurify": "^3.4.11",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "grammy": "^1.40.0",
    "hono": "^4.12.14",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "juice": "^12.1.1",
    "marked": "^17.0.2",
    "mime": "^4.1.0",
    "node-pty": "^1.0.0",
    "pg": "^8.18.0",
    "qrcode": "^1.5.4",
    "rrule": "^2.8.1",
    "semver": "^7.7.4",
    "snoowrap": "^1.23.0",
    "tar": "^7.5.13",
    "telegram": "^2.26.22",
    "turndown": "^7.2.4",
    "uuid": "^13.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6",
    "zod-from-json-schema": "^0.5.2"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/turndown": "^5.0.6"
  }
}
