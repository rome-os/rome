{
  "name": "@rome-os/node-core",
  "version": "0.1.2",
  "description": "JavaScript APIs for Rome device hosts and shared caller daemons",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/daemon-client.d.ts",
      "default": "./dist/daemon-client.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "default": "./dist/daemon.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "default": "./dist/storage.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./socket": {
      "types": "./dist/socket.d.ts",
      "default": "./dist/socket.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && ../../scripts/test-env.sh rstest"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@rstest/core": "^0.11.11",
    "@types/node": "25.2.3",
    "typescript": "^5.9.3",
    "@types/ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rome-os/rome.git",
    "directory": "packages/rome-node-core"
  }
}
