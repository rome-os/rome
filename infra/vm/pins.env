# Every input the host layer is built from. Bump deliberately; the build
# verifies each one before it is used.

# Bump whenever anything in provision/ or files/ changes behavior. Recorded
# on each host in /etc/rome-host/applied, so a fleet can be asked who is behind.
HOST_LAYER_VERSION=1

# Ubuntu cloud image release serial. The dated URL under /releases/ is
# immutable, unlike /noble/current/.
UBUNTU_RELEASE=noble
UBUNTU_VERSION=24.04
UBUNTU_SERIAL=20260911
UBUNTU_SHA256_amd64=612b2c0cc1bc413a6cb8c38fd611794caf0f2b436c50013d8b3794db12ad7354
UBUNTU_SHA256_arm64=

# Docker Engine from download.docker.com: the apt signing key and versions.
DOCKER_APT_KEY_SHA256=1500c1f56fa9e26b9b8f42452a553675796ade0807cdce11975eb98170b3a570
DOCKER_CE_VERSION=5:29.8.1-1~ubuntu.24.04~noble
DOCKER_COMPOSE_PLUGIN_VERSION=5.5.1-1~ubuntu.24.04~noble
CONTAINERD_VERSION=2.3.5-1~ubuntu.24.04~noble

# Rome runtime image, by manifest-list digest. skopeo picks the platform.
ROME_IMAGE_REPO=docker.io/yunfanye/rome
ROME_IMAGE_TAG=1.1.115
ROME_IMAGE_DIGEST=sha256:59ea433f2ce895da9caac8b0b6340edf49c06869ad8a33e347058a15733fc28a
