{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "Asked before the first photo from the composer's camera",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rome uses the camera for photos you send in a chat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rome 用相机拍摄你在聊天中发送的照片。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Asked when Health sync is first turned on",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rome syncs the Health data you allow, such as summaries of your steps, sleep and heart rate, to your own Rome so your Agent can answer questions about your health. You can pause syncing or delete the uploaded data at any time in Settings."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rome 会把你允许的健康数据（例如步数、睡眠和心率的汇总）同步到你自己的 Rome，让你的 Agent 能回答与你健康有关的问题。你可以随时在设置中暂停同步，或删除已上传的数据。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Required by Apple alongside HealthKit; the app never writes to Health",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rome only reads the Health data you allow. It never writes to Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rome 只读取你允许的健康数据，不会写入 Apple 健康。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Asked before saving a photo from the viewer",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rome saves photos from a chat to your library when you ask it to."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你要求时，Rome 会把聊天中的照片存到你的相册。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
