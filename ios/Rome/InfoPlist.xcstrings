{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "Asked before the first photo from the composer's camera",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rome uses the camera for photos you send in a chat."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rome 用相机拍摄你在聊天中发送的照片。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Asked before the first Apple Health read an instance requests",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When your Rome asks, Rome sends the Health data you allow to your Rome and its AI model. Rome never changes your Health data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你的 Rome 提出请求时，Rome 会把你允许的健康数据发送给你的 Rome 及其 AI 模型。Rome 不会更改你的健康数据。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Required by Apple alongside HealthKit; the app never writes to Health",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rome only reads the Health data you allow. It never writes to Apple Health."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rome 只读取你允许的健康数据，不会写入 Apple 健康。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Asked before saving a photo from the viewer",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rome saves photos from a chat to your library when you ask it to."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你要求时，Rome 会把聊天中的照片存到你的相册。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
