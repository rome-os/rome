<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<key>NSHealthShareUsageDescription</key>
	<string>When your Rome asks, Rome sends the Health data you allow to your Rome and its AI model. Rome never changes your Health data.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Rome saves photos from a chat to your library when you ask it to.</string>
	<key>NSCameraUsageDescription</key>
	<string>Rome uses the camera for photos you send in a chat.</string>
	<key>RomeAPNsEnvironment</key>
	<string>$(ROME_APS_ENVIRONMENT)</string>
	<key>RomeCloudOrigin</key>
	<string>$(ROME_CLOUD_ORIGIN)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
