<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
	<!-- Debug builds only. Same as Rome/Info.plist, plus plain HTTP to a Rome
	     on this Mac or the LAN (ROME_LOCAL_*). Keep the two in step. -->
	<key>NSHealthShareUsageDescription</key>
	<string>Rome sends the Health data you allow, such as your steps, sleep and heart rate, to your Rome and your AI model, whose terms apply, so your Agent can answer questions about your health.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Rome sends your calendar events to your Rome and your AI model, whose terms apply, so your Agent can tell you what's on and when you're free, and adds or changes events when you ask it to.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).calendar-sync</string>
	</array>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>When your Agent needs it to answer you, Rome sends your current location to your Rome and your AI model, for that answer only.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Rome saves photos from a chat to your library when you ask it to.</string>
	<!-- Debug builds only: the -RomeSeedHealth launch argument writes test data
	     into the Simulator's Health (Rome/Node/HealthSeed.swift). Release never
	     writes to Health, so Rome/Info.plist has no such key. -->
	<key>NSHealthUpdateUsageDescription</key>
	<string>Debug builds write test data to Health in the Simulator.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Rome uses the microphone to turn your speech into text</string>
	<key>NSCameraUsageDescription</key>
	<string>Rome uses the camera for photos you send in a chat.</string>
	<key>RomeAPNsEnvironment</key>
	<string>$(ROME_APS_ENVIRONMENT)</string>
	<key>RomeAppGroup</key>
	<string>$(ROME_APP_GROUP)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(ROME_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(ROME_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>RomeCloudOrigin</key>
	<string>$(ROME_CLOUD_ORIGIN)</string>
	<key>CFAccessClientId</key>
	<string>$(CF_ACCESS_CLIENT_ID)</string>
	<key>CFAccessClientSecret</key>
	<string>$(CF_ACCESS_CLIENT_SECRET)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!-- A Rome Cloud and instances on this Mac, such as
		     http://cloud.rome.localhost:3000: local networking does not
		     cover names under localhost. -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
