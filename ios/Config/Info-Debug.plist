<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug builds only. Same as Rome/Info.plist, plus plain HTTP to a Rome
	     on this Mac or the LAN (ROME_LOCAL_*). Keep the two in step. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Rome saves photos from a chat to your library when you ask it to.</string>
	<key>NSCameraUsageDescription</key>
	<string>Rome uses the camera for photos you send in a chat.</string>
	<key>RomeAPNsEnvironment</key>
	<string>$(ROME_APS_ENVIRONMENT)</string>
	<key>RomeCloudOrigin</key>
	<string>$(ROME_CLOUD_ORIGIN)</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
