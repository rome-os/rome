{
  "$schema": "https://biomejs.dev/schemas/2.3.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist/**",
      "!**/drizzle/**",
      "!**/migrations/meta/**",
      "!**/.rome/**",
      "!**/first-party-artifacts/**",
      "!scratch/**",
      "!**/mockServiceWorker.js",
      "!packages/web/mock/public/recorded-apps/**",
      "!**/*.css",
      "!**/*.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "suspicious": {
        "noExplicitAny": "warn",
        "noExtraNonNullAssertion": "error",
        "noMisleadingInstantiator": "error",
        "noTsIgnore": "error",
        "noUnsafeDeclarationMerging": "error"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error"
      },
      "style": {
        "noNamespace": "error",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn"
      }
    }
  },
  "overrides": [
    // Rule: code outside a layered context imports it only through its index.ts.
    // Editor feedback only; `pnpm lint:imports` (lint/rules/layers.ts) is the full check.
    // See DEVELOPMENT.md#established-patterns.
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/agent/domain/**",
                      "**/agent/application/**",
                      "**/agent/infrastructure/**"
                    ],
                    "message": "Import a layered context through its index.ts, never from its domain/, application/ or infrastructure/. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Rule: packaging/ depends on nothing else in core. The caller passes values in.
    {
      "includes": ["**/src/apps/packaging/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "..",
                      "../*",
                      "../**",
                      "@/*",
                      "@/**",
                      "!**/lib/output-schema-validator.js"
                    ],
                    "message": "packaging/ must not import from outside packages/core/src/apps/packaging/ — pass values in from the caller instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    // Rule 7 of the code layout rules: an app in rome_apps/ reaches core only through
    // @rome-os/app-runtime and @rome-os/app-web-sdk, since an app ships outside this repo.
    // The `!` entries are app tests that still import core. Each leaves the list once
    // apps can test against core through the SDK; add no new ones.
    {
      "includes": [
        "rome_apps/**",
        "!rome_apps/coding/src/actions/coding-task/index.test.ts",
        "!rome_apps/dream/src/actions/dream/index.test.ts",
        "!rome_apps/dream/src/actions/skill-review/index.test.ts",
        "!rome_apps/dream/src/api/index.test.ts",
        "!rome_apps/showcases/src/api/index.test.ts",
        "!rome_apps/system/src/actions/create-routine/create-routine.test.ts",
        "!rome_apps/system/src/actions/delete-routine/delete-routine.test.ts",
        "!rome_apps/system/src/actions/search-routine/search-routine.test.ts",
        "!rome_apps/system/src/actions/summon/summon.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@rome/core", "@rome/core/**", "**/packages/core/**"],
                    "message": "An app reaches core only through @rome-os/app-runtime and @rome-os/app-web-sdk. See rome_apps/CLAUDE.md."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
