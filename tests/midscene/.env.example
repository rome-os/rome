# Copy this file to .env before running tests locally.
# Do not commit .env. In CI, inject these values as environment variables.
# Model configuration reference:
# https://midscenejs.com/model-common-config.html
MIDSCENE_MODEL_BASE_URL=
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=
MIDSCENE_MODEL_FAMILY=

# Rome mock dev server: run `pnpm dev:mock` in packages/web (port 3200).
ROME_E2E_BASE_URL=http://localhost:3200
HEADLESS=true
