{
  "name": "rome-midscene-e2e",
  "private": true,
  "type": "module",
  "description": "Product-flow E2E for rome-web against the MSW mock dev server, driven by Midscene.",
  "scripts": {
    "test": "midscene-test",
    "nodes": "midscene-test nodes",
    "typecheck": "tsc --noEmit",
    "check:model": "midscene-test model verify",
    "test:setup": "node --experimental-strip-types --test scripts/mock-server.test.mjs scripts/browser-boundary.test.mjs",
    "test:summary": "node --test scripts/write-native-summary.test.mjs scripts/prepare-pages-site.test.mjs scripts/workflow-policy.test.mjs scripts/trusted-report-runs.test.mjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "devDependencies": {
    "@midscene/core": "1.15.3-beta-20261013035603.0",
    "@midscene/test": "1.15.3-beta-20261013035603.0",
    "@midscene/web": "1.15.3-beta-20261013035603.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.8.3",
    "playwright": "^1.45.0",
    "sharp": "0.34.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false,
    "sharp@0.34.5": true
  }
}
