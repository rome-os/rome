{
  "$schema": "https://biomejs.dev/schemas/2.3.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist/**",
      "!**/drizzle/**",
      "!**/migrations/meta/**",
      "!**/.rome/**",
      "!**/first-party-artifacts/**",
      "!scratch/**",
      "!**/mockServiceWorker.js",
      "!packages/web/mock/public/recorded-apps/**",
      "!**/*.css",
      "!**/*.html"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "suspicious": {
        "noExplicitAny": "warn",
        "noExtraNonNullAssertion": "error",
        "noMisleadingInstantiator": "error",
        "noTsIgnore": "error",
        "noUnsafeDeclarationMerging": "error"
      },
      "complexity": {
        "noBannedTypes": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error"
      },
      "style": {
        "noNamespace": "error",
        "useArrayLiterals": "error",
        "useAsConstAssertion": "error"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedFunctionParameters": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/agent/domain/**",
                      "**/agent/application/**",
                      "**/agent/infrastructure/**"
                    ],
                    "message": "Import a layered context through its index.ts, never from its domain/, application/ or infrastructure/. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      },
      "plugins": ["./biome-plugins/agent-layer-import-forms.grit"]
    },
    {
      "includes": ["packages/core/src/agent/domain/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["..", "../**", "@/**"],
                    "message": "agent/domain/ imports only agent/domain/ and packages. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/agent/domain/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../..", "../../**", "@/**"],
                    "message": "agent/domain/ imports only agent/domain/ and packages. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/agent/domain/*/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../..", "../../../**", "@/**"],
                    "message": "agent/domain/ imports only agent/domain/ and packages. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/agent/domain/*/*/*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["..", "../**", "@/**"],
                    "message": "agent/domain/ is nested deeper than its boundary overrides in biome.json cover; add an override for this depth. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/agent/application/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["..", "../**", "!../domain/**", "@/**"],
                    "message": "agent/application/ imports only agent/domain/, agent/application/ and packages. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/agent/application/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../..", "../../**", "!../../domain/**", "@/**"],
                    "message": "agent/application/ imports only agent/domain/, agent/application/ and packages. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/agent/application/*/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../..", "../../../**", "!../../../domain/**", "@/**"],
                    "message": "agent/application/ imports only agent/domain/, agent/application/ and packages. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/agent/application/*/*/*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["..", "../**", "@/**"],
                    "message": "agent/application/ is nested deeper than its boundary overrides in biome.json cover; add an override for this depth. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/agent/infrastructure/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../index",
                      "../index.*",
                      "../application/**",
                      "@/agent/index",
                      "@/agent/index.*",
                      "@/agent/application/**",
                      "**/agent/index",
                      "**/agent/index.*",
                      "**/agent/application/**"
                    ],
                    "message": "agent/infrastructure/ never imports agent/application/ or agent/index.ts. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/agent/infrastructure/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../../index",
                      "../../index.*",
                      "../../application/**",
                      "@/agent/index",
                      "@/agent/index.*",
                      "@/agent/application/**",
                      "**/agent/index",
                      "**/agent/index.*",
                      "**/agent/application/**"
                    ],
                    "message": "agent/infrastructure/ never imports agent/application/ or agent/index.ts. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/agent/infrastructure/*/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../../../index",
                      "../../../index.*",
                      "../../../application/**",
                      "@/agent/index",
                      "@/agent/index.*",
                      "@/agent/application/**",
                      "**/agent/index",
                      "**/agent/index.*",
                      "**/agent/application/**"
                    ],
                    "message": "agent/infrastructure/ never imports agent/application/ or agent/index.ts. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/agent/infrastructure/*/*/*/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "../../../../index",
                      "../../../../index.*",
                      "../../../../application/**",
                      "@/agent/index",
                      "@/agent/index.*",
                      "@/agent/application/**",
                      "**/agent/index",
                      "**/agent/index.*",
                      "**/agent/application/**"
                    ],
                    "message": "agent/infrastructure/ never imports agent/application/ or agent/index.ts. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/agent/infrastructure/*/*/*/*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["..", "../**", "@/**"],
                    "message": "agent/infrastructure/ is nested deeper than its boundary overrides in biome.json cover; add an override for this depth. See DEVELOPMENT.md#established-patterns."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/src/apps/packaging/**/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["..", "../*", "../**", "@/*", "@/**"],
                    "message": "packaging/ must not import from outside packages/core/src/apps/packaging/ — pass values in from the caller instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/agent/**"],
      "plugins": ["./biome-plugins/no-inline-import-type.grit"],
      "linter": {
        "rules": {
          "style": {
            "noUnusedTemplateLiteral": "error"
          }
        }
      }
    }
  ]
}
