# The test team. Not secret.

# The members, as `cos-env --as <member>` takes them. Fixed identifiers: the
# display names and the persons come from the team.json that `cos-env seed`
# reads, so the roster can change without touching this file. Each member posts
# through a webhook of its own in each chat it is in. member1 also has a second
# account, member1:2, as a second webhook in each of its chats.
COS_MEMBERS="member1 member2 member3"

# The shared chats the agent takes part in, by name in the test server, with
# the members in each.
COS_CHATS="general standup leads"
COS_CHAT_MEMBERS_general="member1 member2 member3"
COS_CHAT_MEMBERS_standup="member1 member2 member3"
COS_CHAT_MEMBERS_leads="member1 member2"

# One private chat per member stands in for a direct message with the agent.
# Named <prefix><member>; that member is the only one posting there.
COS_DM_CHAT_PREFIX="dm-"

# The chief of staff agent. The app id names its documents over the app API; the
# agent name, which is the app id namespaced by the owning app, is what a
# connected account links to.
COS_AGENT_APP="chief-of-staff"
COS_AGENT_NAME="chief-of-staff:chief-of-staff"
