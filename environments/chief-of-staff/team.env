# The test team. Not secret: the bot tokens for these members live in
# ~/.rome-environments/chief-of-staff/secrets.env, in the same order.

# Each member's name, as `cos-env --as <member>` takes it. The first member also
# reads and clears the test chats, so its bot needs Manage Messages and Manage
# Threads in the test server.
COS_MEMBERS="ava ben cleo"

# Each member's display name in the test server after up and reset, in the same order.
COS_MEMBER_NAMES="Ava Ben Cleo"

# The test server's text chats the agent takes part in, by name.
COS_CHATS="general planning"

# The agent linked to the agent's connected account.
COS_AGENT="chief-of-staff"
