# The test team. Not secret: the bot tokens live in
# ~/.rome-environments/chief-of-staff/secrets.env, in the same order.

# The members, as `cos-env --as <member>` takes them. Fixed identifiers: the
# display names and the persons come from the team.json that `cos-env seed`
# reads, so the roster can change without touching this file. The first member
# also reads and clears the chats, so its bot needs Manage Messages and Manage
# Threads in the test server.
COS_MEMBERS="member1 member2 member3"

# The shared chats the agent takes part in, by name in the test server.
COS_CHATS="general standup leads"

# One private chat per member stands in for a direct message, since Discord
# refuses direct messages between two bots. Named <prefix><member>, readable
# only by the agent and that member.
COS_DM_CHAT_PREFIX="dm-"

# The chief of staff agent. The app id names its documents over the app API; the
# agent name, which is the app id namespaced by the owning app, is what a
# connected account links to.
COS_AGENT_APP="chief-of-staff"
COS_AGENT_NAME="chief-of-staff:chief-of-staff"
