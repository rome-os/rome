#!/usr/bin/env bash
# The only command the verifier calls. Its contract is in README.md, under
# "cos-env". Keep it stable: a change here is a change to every verifier run.
set -euo pipefail

# shellcheck source=env.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/env.sh"

usage() {
  die "usage:
  cos-env seed <dir>
  cos-env post --as <member|driver> --chat <name> [--thread <id>] [--mention-agent | --mention-second] <text>
  cos-env dm --as <member> <text>
  cos-env read --chat <name> [--thread <id>] [--since <message id>]
  cos-env read --dm <member> [--since <message id>]
  cos-env rename --as <member> <display name>
  cos-env rome stop|start|restart|renew-session --chat <name>
  cos-env rome held [--since <time>]
  cos-env logs <dir> [--since <time>]
  cos-env replay <script> [--gap <seconds>]
  cos-env offline <script> [--for <minutes>]
  cos-env clock [forward <hours> | reset]
  cos-env usage [--per-call] [--since <time>]
  cos-env doc roster|goals
  cos-env memory [--since <time>]
  cos-env chat <name> default|mentions-only|ignore-others|off|every
  cos-env link | unlink
  cos-env reset
  cos-env version"
}

as="" chat="" dm="" thread="" since="" mention=0 gap=1 minutes=60 per_call=0
args=()
command="${1:-}"
[ -n "$command" ] || usage
shift
while [ $# -gt 0 ]; do
  case "$1" in
    --as) as="${2:?--as needs a member}" && shift 2 ;;
    --chat) chat="${2:?--chat needs a chat name}" && shift 2 ;;
    --dm) dm="${2:?--dm needs a member}" && shift 2 ;;
    --thread) thread="${2:?--thread needs a thread id}" && shift 2 ;;
    --since) since="${2:?--since needs a message id or, for logs, a time}" && shift 2 ;;
    --mention-agent) mention=agent && shift ;;
    --mention-second) mention=second && shift ;;
    --gap) gap="${2:?--gap needs seconds}" && shift 2 ;;
    --per-call) per_call=1 && shift ;;
    --for) minutes="${2:?--for needs minutes}" && shift 2 ;;
    --) shift && args+=("$@") && break ;;
    *) args+=("$1") && shift ;;
  esac
done

# A member as --as or --dm names it: one of the team's members, or member1:2,
# member1's second account.
check_member() {
  local member="$1" known
  [ "$member" = "member1:2" ] && return
  for known in "${MEMBERS[@]}"; do [ "$member" = "$known" ] && return; done
  die "no member \"$member\". Members: ${MEMBERS[*]} member1:2"
}

case "$command" in
  seed)
    [ ${#args[@]} -eq 1 ] || usage
    cmd_seed "${args[0]}"
    ;;
  post)
    [ -n "$as" ] && [ -n "$chat" ] && [ ${#args[@]} -gt 0 ] || usage
    [ "$as" = driver ] || check_member "$as"
    load_secrets
    discord post "$as" "$chat" "$thread" "$mention" "${args[*]}"
    ;;
  dm)
    [ -n "$as" ] && [ ${#args[@]} -gt 0 ] || usage
    check_member "$as"
    load_secrets
    discord post "$as" "$COS_DM_CHAT_PREFIX${as%%:*}" "" 0 "${args[*]}"
    ;;
  read)
    if [ -n "$dm" ]; then
      check_member "$dm"
      chat="$COS_DM_CHAT_PREFIX${dm%%:*}"
    fi
    [ -n "$chat" ] || [ -n "$thread" ] || die "read needs --chat <name>, --dm <member> or --thread <id>"
    load_secrets
    discord read "$chat" "$thread" "$since"
    ;;
  rename)
    [ -n "$as" ] && [ ${#args[@]} -gt 0 ] || usage
    check_member "$as"
    load_secrets
    discord rename "$as" "${args[*]}"
    ;;
  rome) cos_rome "${args[0]:-}" ${chat:+--chat "$chat"} ${since:+--since "$since"} ;;
  logs)
    [ ${#args[@]} -eq 1 ] || usage
    cos_logs "${args[0]}" "$since"
    ;;
  replay)
    [ ${#args[@]} -eq 1 ] || usage
    load_secrets
    discord replay "${args[0]}" "$gap" 0
    ;;
  offline)
    [ ${#args[@]} -eq 1 ] || usage
    load_secrets
    cos_offline "${args[0]}" "$minutes"
    ;;
  clock) cos_clock "${args[@]}" ;;
  usage)
    if [ "$per_call" = 1 ]; then cos_usage_per_call "$since"; else cos_usage "$since"; fi
    ;;
  doc) cos_doc "${args[0]:-}" ;;
  memory) cos_memory "$since" ;;
  chat)
    [ ${#args[@]} -eq 2 ] || usage
    load_secrets
    cos_chat "${args[0]}" "${args[1]}"
    ;;
  link | unlink) cos_link "$command" ;;
  reset) cmd_reset ;;
  version) cos_version ;;
  *) usage ;;
esac
