#!/usr/bin/env bash
# The only command the verifier calls. Its contract is in README.md, under
# "cos-env". Keep it stable: a change here is a change to every verifier run.
set -euo pipefail

# shellcheck source=env.sh
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/env.sh"

usage() {
  die "usage:
  cos-env seed <dir>
  cos-env post --as <member> --chat <name> [--thread <id>] [--mention-agent] <text>
  cos-env dm --as <member> <text>
  cos-env read --chat <name> [--thread <id>] [--since <message id>]
  cos-env read --dm <member> [--since <message id>]
  cos-env rename --as <member> <display name>
  cos-env rome stop|start|restart|renew-session --chat <name>
  cos-env logs <dir> [--since <time>]
  cos-env reset
  cos-env version"
}

as="" chat="" dm="" thread="" since="" mention=0
args=()
command="${1:-}"
[ -n "$command" ] || usage
shift
while [ $# -gt 0 ]; do
  case "$1" in
    --as) as="${2:?--as needs a member}" && shift 2 ;;
    --chat) chat="${2:?--chat needs a chat name}" && shift 2 ;;
    --dm) dm="${2:?--dm needs a member}" && shift 2 ;;
    --thread) thread="${2:?--thread needs a thread id}" && shift 2 ;;
    --since) since="${2:?--since needs a message id or, for logs, a time}" && shift 2 ;;
    --mention-agent) mention=1 && shift ;;
    --) shift && args+=("$@") && break ;;
    *) args+=("$1") && shift ;;
  esac
done

# A member as --as or --dm names it: one of the team's members, or member1:2,
# member1's second account.
check_member() {
  local member="$1" known
  [ "$member" = "member1:2" ] && return
  for known in "${MEMBERS[@]}"; do [ "$member" = "$known" ] && return; done
  die "no member \"$member\". Members: ${MEMBERS[*]} member1:2"
}

case "$command" in
  seed)
    [ ${#args[@]} -eq 1 ] || usage
    cmd_seed "${args[0]}"
    ;;
  post)
    [ -n "$as" ] && [ -n "$chat" ] && [ ${#args[@]} -gt 0 ] || usage
    check_member "$as"
    load_secrets
    discord post "$as" "$chat" "$thread" "$mention" "${args[*]}"
    ;;
  dm)
    [ -n "$as" ] && [ ${#args[@]} -gt 0 ] || usage
    check_member "$as"
    load_secrets
    discord post "$as" "$COS_DM_CHAT_PREFIX${as%%:*}" "" 0 "${args[*]}"
    ;;
  read)
    if [ -n "$dm" ]; then
      check_member "$dm"
      chat="$COS_DM_CHAT_PREFIX${dm%%:*}"
    fi
    [ -n "$chat" ] || usage
    load_secrets
    discord read "$chat" "$thread" "$since"
    ;;
  rename)
    [ -n "$as" ] && [ ${#args[@]} -gt 0 ] || usage
    check_member "$as"
    load_secrets
    discord rename "$as" "${args[*]}"
    ;;
  rome) cos_rome "${args[0]:-}" ${chat:+--chat "$chat"} ;;
  logs)
    [ ${#args[@]} -eq 1 ] || usage
    cos_logs "${args[0]}" "$since"
    ;;
  reset) cmd_reset ;;
  version) cos_version ;;
  *) usage ;;
esac
