language js

or {
  TsImportType() as $t where {
    register_diagnostic(span=$t, message="Use a top-level `import type` so the import boundary rules can check it.")
  },
  `import($spec)` as $t where {
    $spec <: r"`.*`",
    register_diagnostic(span=$t, message="Write this dynamic import's path as a string literal so the import boundary rules can check it.")
  }
}
